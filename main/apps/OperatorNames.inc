    while (lo <= hi) {
        const int mid = (lo + hi) / 2;
        const int cmp = strcmp(charId, table[mid].id);
        if (cmp == 0) return table[mid].appellation;
        if (cmp < 0) hi = mid - 1; else lo = mid + 1;
    }
    return nullptr;
}

} // namespace operator_name
